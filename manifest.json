{
  "manifest_version": 3,
  "name": "Polygon Plus",
  "version": "1.2.0",
  "description": "Melhora a aparência e a usabilidade do Polygon (Codeforces): modo escuro, layout moderno, filtro de tabelas, atalhos e mais.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://polygon.codeforces.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Polygon Plus"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "polygon-plus@example.com",
      "strict_min_version": "109.0"
    }
  }
}
